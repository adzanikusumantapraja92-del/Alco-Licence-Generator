{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.alco.license.generator",
  "productName": "ALCO License Generator",
  "toolsets": {
    "wine": "1.0.1",
    "winCodeSign": "1.1.0",
    "nsis": "1.2.1"
  },
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    ".electron-prod/**/*",
    "package.json",
    "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
    "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
    "!**/node_modules/*.d.ts",
    "!**/node_modules/.bin",
    "!scripts/**/*",
    "!src/**/*",
    "!electron/**/*",
    "!.electron-dev/**/*",
    "!.env*",
    "!**/*.map"
  ],
  "extraMetadata": {
    "main": ".electron-prod/main.cjs"
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ],
    "executableName": "ALCO License Generator"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "ALCO License Generator",
    "artifactName": "ALCO License Generator Setup ${version}.exe",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true
  }
}
